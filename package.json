{
  "name": "youtube-video-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube video & audio downloader with a React frontend and Express backend.",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c red,blue \"node server.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server.js",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "youtube-dl-exec": "^3.1.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "vite": "^8.2.0"
  }
}
