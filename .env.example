# ===================================================
# YTSaver - Environment Configuration Example
# ===================================================
# Copy this file to '.env' in this directory if you need custom values.

# ---------------------------------------------------
# Backend Configuration (Node.js / Express)
# ---------------------------------------------------
# Port on which the Express server will listen (Default: 3000).
# Cloud providers (Render, Railway, Heroku) supply this automatically.
PORT=3000

# Application environment ('development' or 'production')
NODE_ENV=production

# ---------------------------------------------------
# Frontend Configuration (Vite / React)
# ---------------------------------------------------
# Base URL for the backend API.
#
# Scenario A (Unified Deployment - Recommended):
# Frontend is built and served directly by the backend on the same domain (npm start).
# -> Leave VITE_API_URL empty.
#
# Scenario B (Split Deployment):
# Frontend is hosted on Vercel/Netlify, backend on Render/Railway/VPS.
# -> Set this to your live backend domain:
# VITE_API_URL=https://your-api-domain.onrender.com
#
# Scenario C (Local Dev):
# -> In local dev (npm run dev), Vite automatically defaults to http://localhost:3000.
VITE_API_URL=
